# Backend proxy
PORT=8787
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: override demo users with real local/SSO-provisioned users.
# Use passwordHash in production-style environments.
# Format:
# AUTH_USERS_JSON=[{"username":"payroll.admin","passwordHash":"pbkdf2$sha256$210000$salt$hash","displayName":"Payroll Admin","role":"payroll_admin","allowedDepartments":[],"allowedCompanies":[],"allowedPayGroups":[]}]

# Workday authentication.
# Prefer bearer token from a secure backend secret store where available.
WORKDAY_BEARER_TOKEN=

# Alternative basic auth for controlled local testing only.
WORKDAY_USERNAME=
WORKDAY_PASSWORD=

# Workday RaaS/API report endpoints.
# Configure report column aliases to match the dashboard data contract documented in docs/Real_Time_Data_Integration.md.
WORKDAY_WORKERS_URL=
WORKDAY_PAYROLL_RESULTS_URL=
WORKDAY_TIME_ENTRIES_URL=
WORKDAY_DEDUCTION_RESULTS_URL=
WORKDAY_TAX_RESULTS_URL=
