# Backend proxy
PORT=8787
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Required in production: portfolio (synthetic data) or live (real Workday integrations).
DEPLOYMENT_PROFILE=portfolio

# Authentication mode: local for development, azure_easy_auth for production.
AUTH_MODE=local
# Production blocks local authentication unless this emergency override is explicitly true.
ALLOW_LOCAL_AUTH_IN_PRODUCTION=false

# Microsoft Entra ID / Azure App Service Easy Auth mappings.
# ENTRA_ROLE_MAPPINGS_JSON={"Payroll.Admin":"payroll_admin","Payroll.Manager":"payroll_manager","HRIS.Analyst":"hris_analyst","Finance.Analyst":"finance_analyst","Department.Manager":"department_manager","Payroll.Auditor":"read_only_auditor"}
# ENTRA_USER_SCOPES_JSON={"manager@example.com":{"allowedDepartments":["Operations"],"allowedCompanies":[],"allowedPayGroups":[]}}

# Optional: override demo users with real local/SSO-provisioned users.
# Use passwordHash in production-style environments.
# Format:
# AUTH_USERS_JSON=[{"username":"payroll.admin","passwordHash":"pbkdf2$sha256$210000$salt$hash","displayName":"Payroll Admin","role":"payroll_admin","allowedDepartments":[],"allowedCompanies":[],"allowedPayGroups":[]}]

# Workday authentication.
# Prefer bearer token from a secure backend secret store where available.
WORKDAY_BEARER_TOKEN=

# Alternative basic auth for controlled local testing only.
WORKDAY_USERNAME=
WORKDAY_PASSWORD=

# Workday RaaS/API report endpoints.
# Configure report column aliases to match the dashboard data contract documented in docs/Real_Time_Data_Integration.md.
WORKDAY_WORKERS_URL=
WORKDAY_PAYROLL_RESULTS_URL=
WORKDAY_TIME_ENTRIES_URL=
WORKDAY_DEDUCTION_RESULTS_URL=
WORKDAY_TAX_RESULTS_URL=

# Workday response hardening.
WORKDAY_FETCH_TIMEOUT_MS=15000
WORKDAY_FETCH_RETRIES=3
WORKDAY_MAX_PAGES=25

# Optional Workday action endpoint. It must accept employeeId, payPeriod, and requestedBy.
WORKDAY_INBOX_TASK_URL=

# Local development/portfolio audit storage. Live deployments require http mode.
DATA_DIR=.data
AUDIT_STORE_MODE=jsonl
# Durable audit API contract: POST {"event": {...}} and GET {"events": [...]}.
# AUDIT_STORE_URL=https://audit-api.example.com/events
# AUDIT_STORE_TOKEN=
AUDIT_STORE_TIMEOUT_MS=10000
# Configure the same retention in the backing database/audit platform.
AUDIT_RETENTION_DAYS=2555
# Approved policy/control identifier covering backup and tested restore procedures.
AUDIT_BACKUP_POLICY_REFERENCE=

# Scheduled Excel delivery through an approved Logic App/Power Automate webhook.
PUBLIC_APP_URL=http://127.0.0.1:8787
REPORT_DELIVERY_WEBHOOK_URL=
REPORT_DELIVERY_INTERVAL_MINUTES=0
REPORT_DELIVERY_RECIPIENTS=
# Shared callback secret; use at least 32 characters in live deployments.
REPORT_DELIVERY_SECRET=
REPORT_DELIVERY_REQUIRE_RECEIPT=false
REPORT_DELIVERY_MAX_ATTACHMENT_BYTES=5242880
# Optional fixed period; leave blank to select the latest payment date.
REPORT_DELIVERY_PAY_PERIOD=
